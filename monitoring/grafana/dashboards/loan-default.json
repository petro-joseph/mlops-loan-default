{
 "uid": "loan-default",
 "title": "Loan default model",
 "schemaVersion": 39,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "panels": [
  {
   "id": 100,
   "type": "row",
   "title": "Service health (platform owns)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 1,
   "type": "stat",
   "title": "Serving model version",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "loan_model_version"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "API up",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "up{job=\"loan-api\"}"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Predictions / min",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(loan_predictions_total[1m]))*60"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Failed model loads (1h)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 1,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(loan_model_reloads_total{result=\"failed\"}[1h])) or vector(0)"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Requests per second by status",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(loan_api_requests_total{path=\"/predict\"}[1m]))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Prediction latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum by (le) (rate(loan_api_request_seconds_bucket{path=\"/predict\"}[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(loan_api_request_seconds_bucket{path=\"/predict\"}[1m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 101,
   "type": "row",
   "title": "Model behaviour (model owner reviews)",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 1
   },
   "collapsed": false,
   "panels": []
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Decisions per minute",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (decision) (rate(loan_predictions_total[1m]))*60",
     "legendFormat": "{{decision}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Share of applicants referred",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(loan_predictions_total{decision=\"refer\"}[2m])) / sum(rate(loan_predictions_total[2m]))",
     "legendFormat": "referred"
    }
   ]
  },
  {
   "id": 9,
   "type": "bargauge",
   "title": "Input drift by feature (PSI: <0.1 stable, >0.25 shifted)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 12,
    "h": 12
   },
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "max": 1,
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.1
       },
       {
        "color": "red",
        "value": 0.25
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sort_desc(loan_feature_psi)",
     "legendFormat": "{{feature}}",
     "instant": true
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Drift over time",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 22,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(loan_feature_psi)",
     "legendFormat": "worst feature PSI"
    },
    {
     "refId": "B",
     "expr": "loan_score_psi",
     "legendFormat": "score PSI"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Applications in drift window",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 30,
    "w": 12,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "loan_drift_window_size",
     "legendFormat": "window"
    }
   ]
  }
 ],
 "tags": [
  "mlops"
 ]
}